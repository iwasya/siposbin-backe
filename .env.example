PORT=5000

SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_key

JWT_SECRET=your_jwt_secret
RESEND_API_KEY=your_resend_api_key

# Firebase service account JSON for Render/production.
# Example: {"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
FIREBASE_SERVICE_ACCOUNT=

# Optional legacy SMTP config if mailer.js is used
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_password
